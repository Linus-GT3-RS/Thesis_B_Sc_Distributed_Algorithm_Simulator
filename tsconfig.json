{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2024",
        "strict": true,
        "noUnusedLocals": true,
        // "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist/src",
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*",
    ]
}